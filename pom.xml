<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.schoste.ddd</groupId>
    <artifactId>utils</artifactId>
    <name>DDD Utils</name>
    <version>1.1.0-SNAPSHOT</version>
    <description>
        Helper classes for the DDD libraries dao and domain-repository: memory-saving holders whose data lives in a storage
        and is kept in memory only weakly (CachedObject, CachedHashMap, CachedNestedMap, CachedQueue), a map with key paths
        (NestedMap) and online statistics (RunningStatistics). The file system implementations are in com.schoste.ddd.util.fs.
        Java 8 or later, no runtime dependencies. Documentation: start with the overview of the Javadoc jar; the README
        (also in the jar as META-INF/README.md) has more examples. The test jar (classifier tests) contains the contract tests.
    </description>
    <url>https://github.com/phisch84/dao-domain-utils</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/phisch84/dao-domain-utils/blob/master/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Philipp Schosteritsch</name>
            <email>s.philipp@schoste.com</email>
            <url>https://www.schoste.com/</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/phisch84/dao-domain-utils.git</connection>
        <developerConnection>scm:git:https://github.com/phisch84/dao-domain-utils.git</developerConnection>
        <url>https://github.com/phisch84/dao-domain-utils</url>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/phisch84/dao-domain-utils/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- compiles against the Java 8 API, even if built with a newer JDK -->
        <maven.compiler.release>8</maven.compiler.release>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
        <pitest-maven.version>1.25.9</pitest-maven.version>
        <junit.version>4.13.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Users of the package see only the artifacts, not the repository: the guide, the changelog and the license
                 (which MIT requires in every copy) ship in META-INF of the jar and of the sources jar -->
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>README.md</include>
                    <include>CHANGELOG.md</include>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <!-- Build and compiler plugin configuration -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <compilerArgs>
                            <!-- suppresses the warning of newer JDKs that release 8 is obsolete -->
                            <arg>-Xlint:-options</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!-- Also provides the test classes (e.g. the CachedObject contract tests) as test-jar -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>test-jar</goal>
                            </goals>
                        </execution>
                        <!-- The module name of the main jar for projects using Java modules (JPMS); without it, it would be
                             "utils", taken from the file name. Part of the public API: changing it breaks those projects.
                             Only the main jar: the test-jar has the same packages and must not claim the same name. -->
                        <execution>
                            <id>default-jar</id>
                            <configuration>
                                <archive>
                                    <manifestEntries>
                                        <Automatic-Module-Name>com.schoste.ddd.util</Automatic-Module-Name>
                                    </manifestEntries>
                                </archive>
                            </configuration>
                        </execution>
                    </executions>
                    <configuration>
                        <archive>
                            <manifest>
                                <addClasspath>true</addClasspath>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>

                <!-- Fixes "tests pass in Eclipse but fail in Maven Surefire -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <reuseForks>false</reuseForks>
                        <forkCount>1</forkCount>
                        <!-- Test classes are named *UT (unit test), which Surefire does not pick up by default.
                             Abstract classes (e.g. the contract tests) are skipped automatically. -->
                        <includes>
                            <include>**/*UT.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
            The Javadoc is the documentation of the library's contract (the usage rules are in the interfaces).
            The library publishes a Javadoc jar for its classes and one for its test classes
            (the contract tests are meant to be used by implementers of further storage implementations).
            doclint checks the Javadoc, and every finding fails the build:
            for the classes, broken HTML, broken references and missing documentation;
            for the test classes, everything except missing documentation (JUnit test classes need no comment for every element).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <quiet>true</quiet>
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <doclint>all</doclint>
                            <!-- the start page of the Javadoc: what to instantiate, the rules of all cached types, an example -->
                            <overview>${project.basedir}/src/main/javadoc/overview.html</overview>
                        </configuration>
                    </execution>
                    <execution>
                        <id>attach-test-javadocs</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <doclint>all,-missing</doclint>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
            Publishes the sources of the classes (-sources.jar) and of the test classes (-test-sources.jar), so IDEs and
            AI assistants in projects which use the library can read the contracts, the usage rules and the contract tests.
            The no-fork goals attach the jars in the package phase without running the build a second time.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                            <goal>test-jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
            Test coverage as a report only: no thresholds, it never fails the build.
            prepare-agent adds the JaCoCo agent to Surefire's argLine; report writes target/site/jacoco/index.html
            (and jacoco.xml / jacoco.csv for tools) in the verify phase.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
            Mutation testing as a report only: PIT changes the code in small ways (mutants) and reports every change
            which no test detects. It is not bound to a phase, because a run takes minutes; start it explicitly:
            mvn -B clean test-compile org.pitest:pitest-maven:mutationCoverage
            The report is target/pit-reports/index.html (and mutations.xml / mutations.csv for tools).
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest-maven.version}</version>
                <configuration>
                    <targetClasses>
                        <param>com.schoste.ddd.util.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.schoste.ddd.util.*UT</param>
                    </targetTests>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                        <param>CSV</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <!-- PIT ends its test JVMs without running shutdown hooks, so cache files which the tests leave to the
                         hook stay behind: they go to target/ (removed by mvn clean) instead of the system's temp folder -->
                    <jvmArgs>
                        <value>-Djava.io.tmpdir=${project.build.directory}</value>
                    </jvmArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/phisch84/dao-domain-utils</url>
        </repository>
    </distributionManagement>
</project>
